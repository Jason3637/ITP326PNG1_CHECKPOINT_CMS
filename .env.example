# ---- Prime's Vault backend environment ----
# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string.
# Project settings -> Database -> Connection string -> "URI".
# Use the Session pooler (port 5432) or Transaction pooler (port 6543) URI.
# Format:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Direct (non-pooled) connection alternative:
#   postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service role key (Project settings -> API -> service_role secret).
# Server-side only. Grants full access - keep it out of any client.
SUPABASE_SERVICE_KEY=

# Name of the Storage bucket for member documents / receipts.
SUPABASE_STORAGE_BUCKET=primes-vault-documents

# Max document upload size in bytes (default 10 MiB) and signed-URL lifetime.
DOCUMENT_MAX_BYTES=10485760
SIGNED_URL_EXPIRY_SECONDS=600

# --- CORS: origins allowed to call /api/* (comma-separated) ---
# Dev default covers the Next.js dev server. Set to the deployed frontend URL(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Notifications: Zoho Mail SMTP (transactional email ONLY, never auth codes) ---
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Prime's Vault
REPAYMENT_REMINDER_LEAD_DAYS=3

# Secret used to sign JWT access tokens. Generate a long random string.
JWT_SECRET_KEY=

# Fernet key that encrypts each user's TOTP secret at rest. REQUIRED for auth.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Issuer name shown in the user's authenticator app (optional).
TOTP_ISSUER=Prime's Vault

# --- Lending parameters (all optional; defaults shown) ---
# Default annual interest rate as a fraction (0.18 = 18% APR). A loan officer
# can override per-decision; the rate actually used is stored on the loan.
DEFAULT_ANNUAL_INTEREST_RATE=0.18
MIN_LOAN_AMOUNT=100
MAX_LOAN_AMOUNT=50000
MIN_LOAN_TERM_MONTHS=1
MAX_LOAN_TERM_MONTHS=60

# Credit evaluation (interim model - see BACKEND.md and
# app/services/credit_evaluation.py). Provisional guesses, not confirmed by
# the client - tune via PUT /api/admin/parameters once real figures land.
MIN_MONTHLY_INCOME=200
MAX_DEBT_TO_INCOME_RATIO=0.40

# development | production | testing
FLASK_ENV=development
